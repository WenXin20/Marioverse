{
	"format_version": "1.8.0",
	"animations": {
		"animation.warp_door.appear": {
			"loop": "hold_on_last_frame",
			"animation_length": 0.5,
			"bones": {
				"body": {
					"scale": {
						"0.0": {
							"vector": [0, 0, 0]
						},
						"0.5": {
							"vector": [1, 1, 1],
							"easing": "easeInOutBack"
						}
					}
				}
			}
		},
		"animation.warp_door.disappear": {
			"loop": "hold_on_last_frame",
			"animation_length": 0.5,
			"bones": {
				"body": {
					"scale": {
						"0.0": {
							"vector": [1, 1, 1],
							"easing": "easeInOutBack"
						},
						"0.5": {
							"vector": [0, 0, 0],
							"easing": "easeOutSine"
						}
					}
				}
			}
		},
		"animation.warp_door.spin": {
			"loop": true,
			"animation_length": 4,
			"bones": {
				"portal": {
					"rotation": {
						"0.0": {
							"vector": [0, 0, 0],
							"easing": "linear"
						},
						"2.0": {
							"vector": [0, -180, 0],
							"easing": "linear"
						},
						"4.0": {
							"vector": [0, -360, 0],
							"easing": "linear"
						}
					}
				}
			}
		}
	},
	"geckolib_format_version": 2
}