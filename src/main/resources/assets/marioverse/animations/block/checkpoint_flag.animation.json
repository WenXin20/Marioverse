					}
				}
			}
		},
		"animation.checkpoint_flag.windy_thunder": {
			"loop": true,
			"bones": {
				"flag": {
					"rotation": {
						"vector": [0, "(25 * math.sin(200 * query.anim_time) * (3.0 * math.cos(175 * query.anim_time)))", 0]
